# ==============================================================================
# HORSE HAVOC - Automated Pipeline Configuration & Credentials
# ==============================================================================

# --- AI METADATA GENERATOR (Gemini API) ---
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# --- PRIMARY SAFE DISPATCH: TELEGRAM BOT ---
# 1. Talk to @BotFather on Telegram, send /newbot, and paste token here.
# 2. Add your bot to your channel/chat, send any message, and get chat_id from:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- OPTIONAL: DISCORD NOTIFICATION WEBHOOK ---
# Server Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=

# --- OPTIONAL: DIRECT SOCIAL MEDIA API STUBS ---
# YouTube Data API v3 (OAuth 2.0 Client Secrets JSON & Cached Token)
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=token.json
YOUTUBE_PRIVACY_STATUS=public

# TikTok Content Posting API (v2)
# Register Developer App at: https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REDIRECT_URI=http://localhost:8080/callback/
# Post Mode: MEDIA_UPLOAD (recommended: uploads directly to your TikTok drafts/inbox) or DIRECT_POST
TIKTOK_POST_MODE=MEDIA_UPLOAD
# Privacy: PUBLIC_TO_EVERYONE, MUTUAL_FOLLOW_FRIENDS, SELF_ONLY (used if DIRECT_POST is chosen)
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

# Alternative Social Aggregators & Webhooks (Fallback if Developer Review is Pending)
AYRSHARE_API_KEY=
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_ID=
TIKTOK_WEBHOOK_URL=

# Instagram Reels (Meta Graph API v20.0)
# Instructions: https://developers.facebook.com (Instagram Business Account)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8080/callback/
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_VERSION=v20.0

# Optional Public Media Hosting for Meta Scraper (Defaults to automatic zero-setup host if empty)
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_ENDPOINT_URL=
# S3_PUBLIC_BASE_URL=
# PUBLIC_MEDIA_URL_BASE=

